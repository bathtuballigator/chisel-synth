# Format example for the planned synthesizer; not supported by current MVP hardware.
# Inspect with SYNTH_CONFIG=config/examples/three-voices.env and ShowSynthConfig.
AMOUNT_FREQ=16
ROOT_MIDI_NOTE=60
VOICE_COUNT=3

VOICE_0_TYPE=square
VOICE_0_ENVELOPE_ENABLED=true
VOICE_0_ATTACK_MS=10
VOICE_0_DECAY_MS=100
VOICE_0_SUSTAIN=0.7
VOICE_0_RELEASE_MS=200

VOICE_1_TYPE=sawtooth
VOICE_1_ENVELOPE_ENABLED=true
VOICE_1_ATTACK_MS=50
VOICE_1_DECAY_MS=250
VOICE_1_SUSTAIN=0.5
VOICE_1_RELEASE_MS=500

# A voice can bypass its envelope. Its ADSR settings are retained as data.
# TYPE can be square, sine, sawtooth, or triangle.
VOICE_2_TYPE=triangle
VOICE_2_ENVELOPE_ENABLED=false
VOICE_2_ATTACK_MS=0
VOICE_2_DECAY_MS=0
VOICE_2_SUSTAIN=1.0
VOICE_2_RELEASE_MS=0
