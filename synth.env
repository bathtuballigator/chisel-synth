# Hardware-generation settings. Run sbt from the repository root.
# Changing these values requires regenerating SystemVerilog and rebuilding the FPGA.

# Number of consecutive notes / switch inputs (Nexys4 supports 1 to 16).
AMOUNT_FREQ=4

# First MIDI note: 60 = C4, 69 = A4. The following notes are semitone steps.
ROOT_MIDI_NOTE=60

# The current MVP supports one square voice without an envelope.
# Other voices/waveforms and ADSR can be described using the example config,
# but need the group's oscillator/envelope integration before hardware generation.
VOICE_COUNT=1
VOICE_0_TYPE=square
VOICE_0_ENVELOPE_ENABLED=false
VOICE_0_ATTACK_MS=10
VOICE_0_DECAY_MS=100
VOICE_0_SUSTAIN=0.7
VOICE_0_RELEASE_MS=200
