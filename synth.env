# Hardware-generation settings. Run sbt from the repository root.
# Changing these values requires regenerating SystemVerilog and rebuilding the FPGA.

# Number of consecutive notes / switch inputs (Nexys4 supports 1 to 16).
AMOUNT_FREQ=4

# First MIDI note: 60 = C4, 69 = A4. The following notes are semitone steps.
ROOT_MIDI_NOTE=60
